* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #ffffff;
    padding: 20px;
}

/* Cabeçalho */
.header {
    background-color: #5c1d1d;
    color: #ffffff;
    text-align: center;
    padding: 15px;
    border: 2px solid #000000;
    margin-bottom: 25px;
}

.header h1 {
    font-family: 'Georgia', serif;
    font-style: italic;
    font-weight: normal;
    font-size: 2.5rem;
}

/* Container de Produtos */
.container {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

.product-card {
    display: flex;
    align-items: center;
    gap: 20px;
}

/* Caixa de Imagem */
.image-box {
    border: 2px solid #5c1d1d;
    padding: 10px;
    width: 160px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}

/* Caixa de Descrição */
.description-box {
    background-color: #5c1d1d;
    color: #ffffff;
    border: 2px solid #000000;
    padding: 20px;
    flex-grow: 1;
}

.description-box p {
    font-size: 1rem;
    line-height: 1.4;
    text-align: left;
}